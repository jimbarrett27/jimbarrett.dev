{% comment %}
  TRMNL full-screen panel: Swedish word of the day. 800x480, 1-bit.

  One of the day's words per push (see swedish.daily_words): the word huge, its
  translation, then an example sentence in Swedish with the English beneath.
  word_size arrives precomputed from the word's length so long phrases like
  "att skrämma bort" stay on one line -- TRMNL runs none of our JavaScript.
  Pure black on white, no greys, in the fitness panel's type: Barlow Condensed
  over IBM Plex Mono, each with a concrete fallback.
{% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&amp;family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&amp;display=swap">
<div class="view view--full">
  <div style="width: 800px; height: 480px; box-sizing: border-box; background: #ffffff; color: #000000; display: flex; flex-direction: column; font-family: 'IBM Plex Mono', ui-monospace, 'DejaVu Sans Mono', monospace; -webkit-font-smoothing: none;">

    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 24px; background: #000000; color: #ffffff; font-size: 14px; font-weight: 600; letter-spacing: 2px;">
      <span>ORD FÖR DAGEN &middot; {{ position }}</span>
      <span>{{ date }}</span>
    </div>

    <div style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center; padding: 0 48px;">
      <span style="font-size: 14px; font-weight: 600; letter-spacing: 2px;">{{ word_class | upcase }}</span>
      <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: {{ word_size }}px; line-height: 1; white-space: nowrap; margin-top: 4px;">{{ word }}</span>
      <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 600; font-size: 40px; line-height: 1.1; margin-top: 8px;">{{ translation }}</span>
    </div>

    <div style="margin: 0 48px; border-top: 3px solid #000000; padding: 16px 0 24px; display: flex; flex-direction: column; gap: 8px;">
      <span style="font-size: 24px; font-weight: 600; line-height: 1.3;">&ldquo;{{ example_sv }}&rdquo;</span>
      <span style="font-size: 16px; font-style: italic; line-height: 1.3;">{{ example_en }}</span>
    </div>

  </div>
</div>
