{% comment %}
  TRMNL full-screen panel: cycling power curve, now vs all-time best. 800x480, 1-bit.

  A sibling of fitness_full.liquid and deliberately in the same visual language:
  same header bar, same left column of big numerals, and the same chart idiom --
  the reference series as a filled black area, the live one as a line stroked
  twice (wide white, then narrow black) so it keeps a knockout halo inside the
  fill. Here the fill is the all-time best and the line is the last 42 days, so
  the line always sits inside the area and the white gap above it is the
  distance back to old form.

  Unlike the fitness chart, the SVG is drawn at its real pixel size rather than
  stretched with preserveAspectRatio="none", which is what lets the axis labels
  be SVG text. All geometry arrives precomputed from fitness.power.
{% endcomment %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&amp;family=IBM+Plex+Mono:wght@400;600&amp;display=swap">
<div class="view view--full">
  <div style="width: 800px; height: 480px; box-sizing: border-box; background: #ffffff; color: #000000; display: flex; flex-direction: column; font-family: 'IBM Plex Mono', ui-monospace, 'DejaVu Sans Mono', monospace; -webkit-font-smoothing: none;">

    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 24px; background: #000000; color: #ffffff; font-size: 14px; font-weight: 600; letter-spacing: 2px;">
      <span>POWER &middot; NOW VS BEST</span>
      <span>UPDATED {{ updated }}</span>
    </div>

    <div style="display: flex; flex-grow: 1;">

      <div style="width: 236px; box-sizing: border-box; padding: 16px 20px; border-right: 3px solid #000000; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="display: flex; flex-direction: column;">
          <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px;">{{ headline_label }} &middot; OF BEST</span>
          <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 104px; line-height: 0.82;">{% if headline_pct %}{{ headline_pct }}<span style="font-size: 40px;">%</span>{% else %}&ndash;{% endif %}</span>
          <span style="font-size: 14px; font-weight: 600; margin-top: 16px;">LAST {{ now_days }} DAYS</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; letter-spacing: 1px;">
            <span style="width: 64px;"></span>
            <span style="width: 56px; text-align: right;">NOW</span>
            <span style="width: 56px; text-align: right;">BEST</span>
          </div>
          {% for row in rows %}
            <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #000000; padding-bottom: 3px;">
              <span style="width: 64px; font-size: 12px; font-weight: 600; letter-spacing: 1px;">{{ row.label }}</span>
              <span style="width: 56px; text-align: right; font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 26px; line-height: 1;">{% if row.now %}{{ row.now }}{% else %}&ndash;{% endif %}</span>
              <span style="width: 56px; text-align: right; font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 600; font-size: 26px; line-height: 1;">{% if row.best %}{{ row.best }}{% else %}&ndash;{% endif %}</span>
            </div>
          {% endfor %}
          <span style="font-size: 11px; letter-spacing: 1px; text-align: right;">WATTS</span>
        </div>
      </div>

      <div style="flex-grow: 1; box-sizing: border-box; padding: 16px 19px 14px 18px; display: flex; flex-direction: column; gap: 10px;">
        <svg width="524" height="370" viewBox="0 0 524 370" style="display: block;" font-family="'IBM Plex Mono', ui-monospace, 'DejaVu Sans Mono', monospace" font-size="11" aria-label="Best power by duration: last {{ now_days }} days against all time, 0 to {{ chart.axis_max }} watts">
          {% for tick in chart.y_ticks %}
            <text x="30" y="{{ tick.y | plus: 4 }}" text-anchor="end">{{ tick.label }}</text>
            <line x1="32" y1="{{ tick.y }}" x2="39" y2="{{ tick.y }}" stroke="#000000" stroke-width="2"></line>
          {% endfor %}
          {% for tick in chart.x_ticks %}
            <line x1="{{ tick.x }}" y1="8" x2="{{ tick.x }}" y2="346" stroke="#000000" stroke-width="1.5" stroke-dasharray="3 9"></line>
            <text x="{{ tick.x }}" y="364" text-anchor="middle">{{ tick.label }}</text>
          {% endfor %}
          {% if chart.best_area != "" %}
            <path d="{{ chart.best_area }}" fill="#000000"></path>
          {% endif %}
          {% for tick in chart.x_ticks %}
            <line x1="{{ tick.x }}" y1="8" x2="{{ tick.x }}" y2="346" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="3 9" stroke-dashoffset="-6"></line>
          {% endfor %}
          {% if chart.now_points != "" %}
            <polyline points="{{ chart.now_points }}" fill="none" stroke="#ffffff" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"></polyline>
            <polyline points="{{ chart.now_points }}" fill="none" stroke="#000000" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"></polyline>
          {% else %}
            <text x="278" y="40" text-anchor="middle" font-size="14" font-weight="600">NO RIDES IN {{ now_days }} DAYS</text>
          {% endif %}
          <line x1="40" y1="8" x2="40" y2="347.5" stroke="#000000" stroke-width="3"></line>
          <line x1="40" y1="347.5" x2="516" y2="347.5" stroke="#000000" stroke-width="3"></line>
        </svg>

        <div style="display: flex; gap: 20px; align-items: center; font-size: 13px; font-weight: 600; padding-left: 40px;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="width: 22px; height: 12px; background: #000000; display: inline-block;"></span>
            <span>ALL-TIME BEST</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="width: 22px; height: 12px; background: #ffffff; border: 3px solid #000000; box-sizing: border-box; display: inline-block;"></span>
            <span>LAST {{ now_days }} DAYS</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
