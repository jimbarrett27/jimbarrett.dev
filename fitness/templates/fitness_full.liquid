{% comment %}
  TRMNL full-screen panel: fitness, fatigue and form. 800x480, 1-bit.

  Ported from the "A - Fitness & fatigue" Claude Design artboard. Two things
  changed in the port and both are load-bearing:

  * All geometry arrives precomputed from fitness.metrics. TRMNL renders this
    server-side and runs none of our JavaScript, so the artboard's renderVals()
    had to move into Python.
  * The y-axis is chosen from the data rather than pinned at 100. At a CTL in
    the teens a fixed 0-100 axis draws a flat line along the floor.

  Pure black on white with no greys: mid-tones dither badly at 1 bit. The
  "lighter" tone in the week box is a 45-degree hatch, which survives the
  conversion predictably. Fatigue is stroked twice -- wide in white, then narrow
  in black -- so it keeps a knockout halo where it crosses the filled fitness
  area, which is also what makes the two series distinguishable without colour.
{% endcomment %}
<!-- TRMNL's framework ships Inter; the artboard's type is Barlow Condensed over
     IBM Plex Mono, so the panel declares them itself. Every rule below carries a
     concrete fallback, because whether TRMNL's renderer fetches external fonts
     needs confirming under trmnlp before trusting it. -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&amp;family=IBM+Plex+Mono:wght@400;600&amp;display=swap">
<div class="view view--full">
  <div style="width: 800px; height: 480px; box-sizing: border-box; background: #ffffff; color: #000000; display: flex; flex-direction: column; font-family: 'IBM Plex Mono', ui-monospace, 'DejaVu Sans Mono', monospace; -webkit-font-smoothing: none;">

    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 24px; background: #000000; color: #ffffff; font-size: 14px; font-weight: 600; letter-spacing: 2px;">
      <span>FITNESS &middot; 90 DAYS</span>
      <span>UPDATED {{ updated }}</span>
    </div>

    <div style="display: flex; flex-grow: 1;">

      <div style="width: 236px; box-sizing: border-box; padding: 16px 20px; border-right: 3px solid #000000; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="display: flex; flex-direction: column;">
          <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px;">FITNESS &middot; CTL</span>
          <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 118px; line-height: 0.82;">{{ ctl | round }}</span>
          <span style="font-size: 14px; font-weight: 600; margin-top: 16px;">{{ ctl_delta_label }} IN 7 DAYS</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <div style="display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2px solid #000000; padding-bottom: 4px;">
            <span style="font-size: 13px; font-weight: 600; letter-spacing: 1px;">FATIGUE</span>
            <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 38px; line-height: 1;">{{ atl }}</span>
          </div>
          <div style="display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2px solid #000000; padding-bottom: 4px;">
            <span style="font-size: 13px; font-weight: 600; letter-spacing: 1px;">FORM</span>
            <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 38px; line-height: 1;">{{ form }}</span>
          </div>
          <div style="display: flex; align-items: baseline; justify-content: space-between;">
            <span style="font-size: 13px; font-weight: 600; letter-spacing: 1px;">42D PEAK</span>
            <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 38px; line-height: 1;">{{ ctl_peak_42d }}</span>
          </div>
        </div>
      </div>

      <div style="flex-grow: 1; box-sizing: border-box; padding: 16px 22px 14px 18px; display: flex; flex-direction: column; gap: 8px;">

        <div style="display: flex; align-items: stretch; gap: 5px;">
          <div style="width: 34px; height: 194px; display: flex; flex-direction: column; justify-content: space-between; margin-top: -6px; margin-bottom: -6px;">
            {% for tick in chart.ticks %}
              <div style="display: flex; align-items: center; justify-content: flex-end; gap: 4px; height: 12px;">
                <span style="font-size: 11px; line-height: 1;">{{ tick.label }}</span>
                <span style="width: 7px; height: 2px; background: #000000; display: inline-block;"></span>
              </div>
            {% endfor %}
          </div>

          <svg viewBox="0 0 520 262" preserveAspectRatio="none" style="flex-grow: 1; height: 194px; display: block;" aria-label="Fitness and fatigue over the last 90 days, training load 0 to {{ chart.axis_max }}">
            {% for y in chart.grid_y %}
              <line x1="1.5" y1="{{ y }}" x2="520" y2="{{ y }}" stroke="#000000" stroke-width="1.5" stroke-dasharray="3 9"></line>
            {% endfor %}
            <path d="{{ chart.ctl_area }}" fill="#000000"></path>
            {% for y in chart.grid_y %}
              <line x1="1.5" y1="{{ y }}" x2="520" y2="{{ y }}" stroke="#ffffff" stroke-width="1.5" stroke-dasharray="3 9" stroke-dashoffset="-6"></line>
            {% endfor %}
            <polyline points="{{ chart.atl_points }}" fill="none" stroke="#ffffff" stroke-width="6" stroke-linejoin="round"></polyline>
            <polyline points="{{ chart.atl_points }}" fill="none" stroke="#000000" stroke-width="2" stroke-linejoin="round"></polyline>
            <line x1="1.5" y1="0" x2="1.5" y2="262" stroke="#000000" stroke-width="3"></line>
            <line x1="0" y1="259.5" x2="520" y2="259.5" stroke="#000000" stroke-width="3"></line>
          </svg>
        </div>

        <div style="display: flex; justify-content: space-between; font-size: 12px; padding-left: 39px;">
          <span>90 DAYS AGO</span>
          <span>TODAY</span>
        </div>

        <div style="display: flex; gap: 20px; align-items: center; font-size: 13px; font-weight: 600;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="width: 22px; height: 12px; background: #000000; display: inline-block;"></span>
            <span>FITNESS</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="width: 22px; height: 12px; background: #ffffff; border: 2px solid #000000; box-sizing: border-box; display: inline-block;"></span>
            <span>FATIGUE</span>
          </div>
        </div>

        <div style="border: 3px solid #000000; box-sizing: border-box; display: flex; flex-direction: column; margin-top: 2px;">
          <div style="padding: 5px 12px; background: #000000; color: #ffffff; font-size: 12px; font-weight: 600; letter-spacing: 2px; display: flex; justify-content: space-between;">
            <span>THIS WEEK</span>
            <span>{{ form_label | upcase }}</span>
          </div>
          <div style="padding: 10px 12px; display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: baseline;">
              <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 34px; line-height: 1;">{{ this_week.km }}<span style="font-size: 16px; font-weight: 600; margin-left: 3px;">KM</span></span>
              <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 34px; line-height: 1;">{{ this_week.hours }}<span style="font-size: 16px; font-weight: 600; margin-left: 3px;">H</span></span>
              <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 34px; line-height: 1;">{{ this_week.load }}<span style="font-size: 16px; font-weight: 600; margin-left: 3px;">LOAD</span></span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 11px; letter-spacing: 1px; border-top: 2px solid #000000; padding-top: 6px;">
              <span>{{ this_week.sessions }} SESSIONS &middot; LAST WEEK {{ last_week.km }} KM</span>
              <span>{% if last_activity != "" %}{{ last_activity | upcase }} &middot; {{ last_activity_ago }}D AGO{% else %}NO RECENT ACTIVITY{% endif %}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
