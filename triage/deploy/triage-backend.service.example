# systemd unit for the triage FastAPI backend.
# Install to /etc/systemd/system/triage-backend.service (see deploy/README.md).

[Unit]
Description=Paper triage backend (FastAPI)
After=network.target
# TRIAGE_OBSIDIAN_VAULT lives under /mnt/storage, which fstab mounts with
# `nofail` -- the box boots happily without it. Without this line systemd
# would start the service anyway and stubs would be written into a plain
# directory on the root filesystem, where nothing ever syncs them.
RequiresMountsFor=/mnt/storage

[Service]
User=jim
WorkingDirectory=/home/jim/deploy/jimbarrett.dev
EnvironmentFile=/etc/triage.env
# Runtime data (the screening database) lives outside the checkout, so this
# directory stays disposable. See util/paths.py.
Environment=JIMBARRETT_DATA_DIR=/home/jim/data
# Full path to uv (from `command -v uv`); runs the app from the repo's venv.
ExecStart=/home/jim/.local/bin/uv run python -m triage
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
